# Netlify site environment variables for the Hermes Agent proxy.
# Configure these in Netlify Site configuration > Environment variables.
# Never place the API_SERVER_KEY in index.html or app.js.
HERMES_API_URL=https://hermes.example.com/v1
HERMES_API_KEY=USE_THE_SAME_SECRET_AS_HERMES_API_SERVER_KEY
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_MS=50000
# Set to the exact published AdsPilot URL in production. Example:
SITE_ORIGIN=https://your-adspilot-site.netlify.app
